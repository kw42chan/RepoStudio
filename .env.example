# Optional: OpenAI API key for live AI ideation, script generation, and visual template extraction.
# Without this key, RepoStudio runs with a smart local deterministic generator.
OPENAI_API_KEY=

# Optional: Buffer OAuth 2.0 credentials for one-click "Connect with Buffer"
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Optional: Personal Buffer access token fallback
BUFFER_ACCESS_TOKEN=
