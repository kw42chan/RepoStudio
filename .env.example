# Optional: OpenRouter API key (recommended) for AI ideation, script generation, and visual template extraction.
# Without an AI key, RepoStudio runs with a smart local deterministic generator.
OPENROUTER_API_KEY=
# Optional OpenRouter model overrides (defaults: deepseek/deepseek-v4.1-flash-1017 for text, google/gemini-2.5-flash for vision)
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# Optional: Direct OpenAI API key fallback if OPENROUTER_API_KEY is not set
OPENAI_API_KEY=

# Optional: Buffer OAuth 2.0 credentials for one-click "Connect with Buffer"
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Optional: Personal Buffer access token fallback
BUFFER_ACCESS_TOKEN=
